/* 全局样式 + 主题变量 */
page {
  background: #f2f8f7;
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #2a3b3a;
}

/* ---- 四套主题（页面根节点挂 class）---- */
.theme-tiffany { --primary: #0abab5; --primary-deep: #078e89; --primary-soft: #56d8cd; --primary-light: #e0f5f3; --card: #ffffff; --text: #2a3b3a; --text-sub: #8a9a97; --danger: #ff5c5c; }
.theme-purple  { --primary: #6c7cff; --primary-deep: #5866ea; --primary-soft: #9b8cff; --primary-light: #eef0ff; --card: #ffffff; --text: #333333; --text-sub: #8a8f99; --danger: #ff5c5c; }
.theme-pink    { --primary: #ff7fa5; --primary-deep: #e8658f; --primary-soft: #ffb0c6; --primary-light: #ffeef3; --card: #ffffff; --text: #3d2e33; --text-sub: #9c8490; --danger: #ff5c5c; }
.theme-blue    { --primary: #58aef2; --primary-deep: #3d8fd9; --primary-soft: #a4d8fb; --primary-light: #eaf5fe; --card: #ffffff; --text: #2e3a44; --text-sub: #8a99a6; --danger: #ff5c5c; }

.page-wrap { min-height: 100vh; padding-bottom: 170rpx; box-sizing: border-box; }

.card {
  background: var(--card);
  border-radius: 24rpx;
  margin: 20rpx 24rpx;
  padding: 26rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, .05);
  box-sizing: border-box;
}

.section-title { font-size: 27rpx; font-weight: 600; color: var(--text); margin-bottom: 16rpx; }
.section-title .hint { font-size: 21rpx; font-weight: 400; color: var(--text-sub); margin-left: 10rpx; }

.empty {
  text-align: center; color: var(--text-sub); font-size: 25rpx;
  padding: 60rpx 0; white-space: pre-line; line-height: 1.8;
}

.btn-primary {
  background: linear-gradient(140deg, var(--primary-deep), var(--primary) 55%, var(--primary-soft));
  color: #fff; border-radius: 24rpx; text-align: center;
  padding: 26rpx 0; font-size: 31rpx; font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .12);
}
.btn-primary:active { opacity: .85; }

/* ---- 日记卡片（列表通用）---- */
.diary-item {
  background: var(--card); border-radius: 20rpx;
  margin: 16rpx 24rpx; padding: 22rpx;
  box-shadow: 0 3rpx 14rpx rgba(0, 0, 0, .05);
}
.diary-item .top { display: flex; align-items: center; gap: 14rpx; }
.diary-item .mood-img { width: 60rpx; height: 62rpx; flex-shrink: 0; }
.diary-item .title { font-size: 29rpx; font-weight: 600; color: var(--text); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.diary-item .time { font-size: 22rpx; color: var(--text-sub); }
.diary-item .preview { font-size: 25rpx; color: var(--text-sub); margin-top: 10rpx; line-height: 1.6; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.diary-item .thumbs { display: flex; gap: 10rpx; margin-top: 14rpx; }
.diary-item .thumbs image { width: 150rpx; height: 150rpx; border-radius: 12rpx; }
.diary-item .meta-row { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; margin-top: 14rpx; }
.diary-item .tag {
  font-size: 20rpx; color: var(--text-sub); background: var(--bg-tag, #f4f6f8);
  padding: 4rpx 12rpx; border-radius: 8rpx;
}
.diary-item .tag.pub { background: var(--primary-light); color: var(--primary); }
.diary-item .edit-btn { color: var(--primary); font-size: 23rpx; padding: 4rpx 10rpx; margin-left: auto; }
.diary-item .del-btn { color: var(--danger); font-size: 23rpx; padding: 4rpx 10rpx; }

/* ---- 详情弹窗 ---- */
.modal-mask {
  position: fixed; inset: 0; background: rgba(0, 0, 0, .5);
  z-index: 300; display: none; align-items: center; justify-content: center;
}
.modal-mask.show { display: flex; }
.modal-box {
  background: var(--card); width: 84%; max-height: 76vh;
  border-radius: 28rpx; padding: 40rpx 36rpx; position: relative;
  box-sizing: border-box; overflow-y: auto;
}
.modal-box .close { position: absolute; top: 24rpx; right: 30rpx; font-size: 32rpx; color: var(--text-sub); padding: 8rpx; }
.modal-box .m-title { display: flex; align-items: center; gap: 14rpx; font-size: 33rpx; font-weight: 700; color: var(--text); padding-right: 50rpx; }
.modal-box .m-title image { width: 52rpx; height: 54rpx; }
.modal-box .m-meta { font-size: 22rpx; color: var(--text-sub); margin: 14rpx 0 20rpx; line-height: 1.7; }
.modal-box .m-content { font-size: 29rpx; line-height: 1.9; white-space: pre-wrap; color: var(--text); }
.modal-box .m-photos { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; }
.modal-box .m-photos image { width: 31%; height: 200rpx; border-radius: 14rpx; }
.modal-box .m-audio { margin-top: 24rpx; width: 100%; }
.m-actions { display: flex; gap: 14rpx; flex-wrap: wrap; margin-top: 26rpx; }
.m-actions .p-btn {
  background: #f0f2f8; color: var(--text); font-size: 24rpx;
  padding: 14rpx 24rpx; border-radius: 16rpx;
}
.m-actions .p-btn.hl { background: var(--primary-light); color: var(--primary); font-weight: 600; }
