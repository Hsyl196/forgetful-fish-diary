/* 编辑页样式 */
.ed-page { padding-bottom: 80rpx; }
.edit-header {
  background: linear-gradient(140deg, var(--primary-deep) 0%, var(--primary) 52%, var(--primary-soft) 100%);
  color: #fff; padding: 26rpx 28rpx;
  display: flex; align-items: center; justify-content: space-between;
}
.back { font-size: 28rpx; width: 100rpx; }
.center { text-align: center; flex: 1; }
.center .t { font-size: 32rpx; font-weight: 700; }
.center .d { font-size: 21rpx; opacity: .85; margin-top: 6rpx; }

.mood-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.mood-item {
  width: calc((100% - 36rpx) / 4); box-sizing: border-box;
  background: rgba(0,0,0,.03); border: 3rpx solid transparent;
  border-radius: 20rpx; padding: 16rpx 0; text-align: center;
  display: flex; flex-direction: column; align-items: center;
}
.mood-item.active { background: var(--primary-light); border-color: var(--primary); transform: scale(1.04); }
.mood-item .m-img { width: 76rpx; height: 78rpx; }
.mood-item .m-name { font-size: 21rpx; color: var(--text-sub); margin-top: 8rpx; }
.mood-item.active .m-name { color: var(--primary); font-weight: 600; }
.mood-toggle {
  width: calc((100% - 36rpx) / 4);
  display: flex; align-items: center; justify-content: center;
  border: 2rpx dashed var(--text-sub); border-radius: 20rpx;
  font-size: 20rpx; color: var(--text-sub); padding: 16rpx 0;
}

.env-row {
  display: flex; align-items: center; gap: 12rpx;
  background: rgba(0,0,0,.03); border-radius: 16rpx;
  padding: 18rpx 22rpx; margin-top: 16rpx;
}
.env-row .em { font-size: 30rpx; }
.env-row .val { flex: 1; font-size: 24rpx; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.env-row .act { font-size: 22rpx; color: var(--primary); padding: 4rpx 10rpx; flex-shrink: 0; }

.title-input {
  margin-top: 24rpx; background: rgba(0,0,0,.03); border-radius: 16rpx;
  padding: 20rpx 24rpx; font-size: 29rpx; font-weight: 600; color: var(--text);
}
.content-input {
  margin-top: 16rpx; background: rgba(0,0,0,.03); border-radius: 16rpx;
  padding: 20rpx 24rpx; font-size: 27rpx; color: var(--text);
  width: 100%; min-height: 260rpx; box-sizing: border-box; line-height: 1.8;
}
.ph { color: var(--text-sub); }

.photo-row { display: flex; flex-wrap: wrap; gap: 14rpx; }
.photo-thumb { position: relative; width: 200rpx; height: 200rpx; }
.photo-thumb image { width: 100%; height: 100%; border-radius: 14rpx; }
.photo-thumb .del {
  position: absolute; top: -10rpx; right: -10rpx; width: 44rpx; height: 44rpx;
  background: rgba(0,0,0,.6); color: #fff; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; font-size: 22rpx;
}
.add-photo {
  width: 200rpx; height: 200rpx; border: 2rpx dashed var(--text-sub);
  border-radius: 14rpx; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 6rpx;
  font-size: 20rpx; color: var(--text-sub); box-sizing: border-box;
}
.add-photo .plus { font-size: 44rpx; line-height: 1; }

.rec-row {
  display: flex; align-items: center; gap: 20rpx;
  background: rgba(0,0,0,.03); border-radius: 16rpx; padding: 20rpx 24rpx;
}
.rec-btn {
  width: 84rpx; height: 84rpx; border-radius: 50%; flex-shrink: 0;
  background: linear-gradient(140deg, var(--primary-deep), var(--primary) 55%, var(--primary-soft));
  color: #fff; font-size: 36rpx; display: flex; align-items: center; justify-content: center;
}
.rec-btn.recording { animation: pulse 1.2s ease-in-out infinite; }
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.12); }
}
.rec-info { flex: 1; }
.rec-time { font-size: 30rpx; font-weight: 700; color: var(--text); }
.rec-hint { font-size: 21rpx; color: var(--text-sub); margin-top: 4rpx; }
.rec-act { font-size: 23rpx; color: var(--primary); padding: 6rpx 8rpx; }
.rec-act.del { color: var(--danger); }

.save-btn { margin: 30rpx 24rpx 0; }

/* 心情网格：3 列模式 */
.mood-grid .mood-item:nth-child(4n) { }
